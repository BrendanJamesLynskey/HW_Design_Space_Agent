# equiv_m3_round: generated by hw_dse.rtl.formal -- run with `sby -f equiv_m3_round.sby` from formal/
# (first `python -m hw_dse.rtl.formal --write` to generate the DUT RTL into build/formal/rtl/)
[options]
mode prove
depth 15

[engines]
smtbmc z3

[script]
read -formal cordic_pipelined_w8_n9_am1_g2_round.sv
read -formal cordic_pipelined_m_m3_w8_n9_am1_g2_round.sv
read -formal equiv_m3_round.sv
prep -top equiv_m3_round

