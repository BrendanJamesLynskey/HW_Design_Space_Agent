# equiv_m4_round: generated by hw_dse.rtl.formal -- run with `sby -f equiv_m4_round.sby` from formal/
# (first `python -m hw_dse.rtl.formal --write` to generate the DUT RTL into build/formal/rtl/)
[options]
mode prove
depth 14

[engines]
smtbmc z3

[script]
read -formal cordic_pipelined_w8_n8_ap2_g1_round.sv
read -formal cordic_pipelined_m_m4_w8_n8_ap2_g1_round.sv
read -formal equiv_m4_round.sv
prep -top equiv_m4_round

