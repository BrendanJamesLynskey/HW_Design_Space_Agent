# Copy to .env (git-ignored) and fill in what you use. Never commit real keys.
# The CLI loads .env automatically; plain environment variables work too.

# Which provider the agent uses: fake | anthropic | openai | gemini | ollama | openrouter
HW_DSE_PROVIDER=fake
# HW_DSE_MODEL=                 # overrides the per-provider model variable below
# HW_DSE_TEMPERATURE=0.3
# HW_DSE_STRUCTURED_METHOD=function_calling   # or json_schema
# HW_DSE_MAX_TOKENS=6000

# OpenRouter (OpenAI-compatible; ChatOpenAI with base_url https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# OPENROUTER_REASONING=off      # off | low | medium | high (unset = provider default)

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=

# Ollama (local open-weights models; no key)
# OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
