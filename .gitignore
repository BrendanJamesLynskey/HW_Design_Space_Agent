# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/

# Secrets: never commit real keys
.env
.env.local

# Reference RTL is fetched at a pinned commit by scripts/fetch_reference_rtl.sh
