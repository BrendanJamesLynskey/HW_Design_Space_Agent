!third_party/CORDIC/

# Simulation scratch
rtl_harness/build/
*.vvp
*.vcd

# Agent run outputs (example runs we want to keep are copied to docs/)
runs/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Eval scratch (committed results live in eval/results.md and eval/data/)
eval/scratch/

# Editor / OS
.vscode/
.idea/
.DS_Store

# SymbiYosys work directories (only the .sby/.sv jobs are committed)
formal/*/
